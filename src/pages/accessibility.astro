---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site, contact, legal, formatDate, telUrl, images } from '../config/site.config';
import { breadcrumbSchema, home } from '../lib/schema';

const crumbs = [home, { label: 'הצהרת נגישות', href: '/accessibility/' }];
---
<BaseLayout title="הצהרת נגישות" description={`הצהרת הנגישות של אתר ${site.name}: רמת הנגישות, מה עשינו באתר ופרטי רכז הנגישות.`} schema={[breadcrumbSchema(crumbs)]}>
  <PageHero title="הצהרת נגישות" lead={`עודכן לאחרונה: ${formatDate(legal.accessibilityReviewed)}`} crumbs={crumbs} image={images.workshop} imageAlt={images.workshopAlt} />
  <section class="section">
    <div class="narrow prose">
      <p>אנחנו רואים חשיבות רבה במתן שירות שווה לכל אדם, כולל אנשים עם מוגבלות. האתר נבנה כך שיהיה נגיש, בהתאם לתקנות שוויון זכויות לאנשים עם מוגבלות (התאמות נגישות לשירות), התשע"ג-2013.</p>
      <h2>רמת הנגישות</h2>
      <p>האתר נבנה בהתאם לתקן הישראלי ת"י 5568, המבוסס על הנחיות WCAG 2.0 ברמה AA.</p>
      <h2>מה עשינו באתר</h2>
      <ul>
        <li>ניווט מלא במקלדת, כולל התפריט, מחשבון התקציב, בדיקת הבריאות השיווקית, שאלות נפוצות וטפסים, עם סימון ברור של הרכיב הפעיל.</li>
        <li>קישור "דלגו לתוכן הראשי" בתחילת כל עמוד.</li>
        <li>ניגודיות צבעים לפי דרישות רמה AA, גם על הבלוקים הצבעוניים: טקסט קטן מוצג רק על רקעים שעומדים בדרישה.</li>
        <li>מבנה כותרות היררכי, תיאור טקסטואלי לתמונות משמעותיות ותוויות לכל שדות הטופס.</li>
        <li>המשפך בדף הבית מציג את כל המספרים גם כטקסט.</li>
        <li>התאמה לכל גדלי המסך ואפשרות הגדלת טקסט עד 200% בלי אובדן תוכן.</li>
        <li>כיבוד הגדרת "הפחתת תנועה" של מערכת ההפעלה: האנימציות מבוטלות אוטומטית.</li>
        <li>הנגישות מובנית בקוד האתר ואינה נשענת על תוסף נגישות חיצוני.</li>
      </ul>
      <h2>נגישות השירות</h2>
      <p>הפגישות מתקיימות בעסק שלכם, במשרד או בזום, לפי מה שנוח לכם. אפשר לפנות בטלפון, בוואטסאפ, במייל או דרך הטופס באתר.</p>
      <h2>נתקלתם בבעיה?</h2>
      <p>אם מצאתם רכיב שאינו נגיש, נשמח לדעת ולתקן. פרטי רכז הנגישות:</p>
      <ul>
        <li>שם: {legal.accessibilityCoordinator}</li>
        <li>טלפון: <a href={telUrl} class="ltr">{contact.phone}</a></li>
        <li>מייל: <a href={`mailto:${legal.accessibilityEmail}`}>{legal.accessibilityEmail}</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
