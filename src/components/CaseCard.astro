---
import { industryBySlug, areaBySlug, type CaseStudy } from '../config/site.config';
interface Props { study: CaseStudy; headingLevel?: 'h2' | 'h3' }
const { study: c, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const ind = industryBySlug(c.industry);
const area = areaBySlug(c.area);
---
<article class="case">
  <a href={`/cases/${c.slug}/`}>
    <div class:list={['big', 'block', `block--${c.tone}`, 'shape-circle']}>
      <span class="value">{c.headline.value}</span>
      <span class="vlabel">{c.headline.label}</span>
    </div>
    <div class="body">
      <p class="meta">{ind?.navTitle}{area ? `, ${area.name}` : ''}</p>
      <H class="title">{c.title}</H>
      <p class="client">{c.client}, {c.months} חודשי ליווי</p>
    </div>
  </a>
</article>

<style>
  .case a { display: grid; gap: var(--s-4); text-decoration: none; color: var(--c-berry); background: var(--c-card); border-radius: var(--r-block); padding: var(--s-3); height: 100%; border: 2px solid transparent; transition: border-color 200ms var(--ease); }
  .case a:hover { border-color: var(--c-pink); }
  .big { display: grid; align-content: end; min-height: 170px; padding: var(--s-5); }
  .value { position: relative; z-index: 1; font-family: var(--font-head); font-weight: 700; font-size: clamp(2.5rem, 2rem + 2vw, 3.5rem); line-height: 1; }
  .vlabel { position: relative; z-index: 1; font-family: var(--font-head); font-weight: 700; font-size: 1.25rem; }
  .body { padding: 0 var(--s-3) var(--s-3); display: grid; gap: 6px; }
  .meta { font-size: 0.9375rem; font-weight: 700; color: var(--c-cyan-deep); }
  .title { font-size: 1.375rem; }
  .client { font-size: 0.9375rem; color: var(--c-muted); }
  .case a:hover .title { text-decoration: underline; text-underline-offset: 0.2em; }
</style>
