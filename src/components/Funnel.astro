---
// Signature element: a marketing funnel from one case study, drawn as stacked bars that narrow
// step by step, with the conversion rate between steps. The bars grow once when they come into
// view; without JavaScript or with reduced motion they are drawn at full size.
import { funnel } from '../config/site.config';

// Widths follow the funnel order, not the raw numbers (48,000 vs 71 would be invisible on a linear scale)
const widths = [100, 80, 60, 42];
const steps = funnel.steps.map((s, i) => ({
  ...s,
  width: widths[i] ?? 40,
  rate: i > 0 ? ((s.value / funnel.steps[i - 1].value) * 100).toFixed(s.value / funnel.steps[i - 1].value < 0.1 ? 1 : 0) : null,
}));
---
<figure class="funnel" data-funnel>
  <figcaption class="cap"><strong>{funnel.title}</strong><span>{funnel.caption}</span></figcaption>
  <ol>
    {steps.map((s, i) => (
      <li>
        {s.rate && <span class="rate">{s.rate}% ממשיכים</span>}
        <div class="bar" style={`--w:${s.width}%; --d:${i * 140}ms`}>
          <span class="label">{s.label}</span>
          <span class="val">{s.value.toLocaleString('he-IL')}</span>
        </div>
      </li>
    ))}
  </ol>
  <a class="more" href={`/cases/${funnel.caseSlug}/`}>לסיפור המלא של הלקוחה</a>
</figure>

<style>
  .funnel { margin: 0; display: grid; gap: var(--s-4); position: relative; z-index: 1; }
  .cap { display: grid; gap: 2px; }
  .cap strong { font-family: var(--font-head); font-size: 1.25rem; font-weight: 600; color: #fff; }
  .cap span { font-size: 0.9375rem; color: var(--c-blush); }
  ol { list-style: none; display: grid; gap: 6px; }
  li { display: grid; justify-items: center; }
  .rate { font-size: 0.8125rem; font-weight: 700; color: var(--c-sun); padding-block: 2px; }
  .bar {
    width: var(--w); display: flex; justify-content: space-between; align-items: center; gap: var(--s-3);
    min-height: 54px; padding-inline: var(--s-4); border-radius: 999px; background: var(--c-card); color: var(--c-berry);
    transition: width 700ms var(--ease) var(--d), opacity 400ms var(--ease) var(--d);
  }
  li:nth-child(2) .bar { background: var(--c-blush); }
  li:nth-child(3) .bar { background: var(--c-sun); }
  li:last-child .bar { background: var(--c-pink-deep); color: #fff; }
  .label { font-weight: 700; font-size: 0.9375rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .val { font-family: var(--font-head); font-weight: 700; font-size: 1.375rem; }
  :global(.js) .funnel:not(.is-in) .bar { width: 22%; opacity: 0.4; }
  .more { justify-self: start; color: #fff; font-weight: 700; min-height: 44px; display: inline-flex; align-items: center; }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .funnel:not(.is-in) .bar { width: var(--w); opacity: 1; }
    .bar { transition: none; }
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>('[data-funnel]');
  if (el) {
    if (!('IntersectionObserver' in window)) el.classList.add('is-in');
    else {
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { el.classList.add('is-in'); io.disconnect(); } }), { threshold: 0.35 });
      io.observe(el);
    }
  }
</script>
